# Database (Neon). Pooled URL at runtime, unpooled for drizzle-kit.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=

# Recommendation API (server only, never in the client bundle)
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
GOOGLE_PLACES_SERVER_KEY=

# Unsplash, for trip cover photos. Without it trips keep a place photo.
UNSPLASH_ACCESS_KEY=

# Agent model. AGENT_PROVIDER=codex uses the ChatGPT subscription tokens in the
# codex_credentials table; AGENT_PROVIDER=openai uses OPENAI_API_KEY.
AGENT_PROVIDER=codex
AGENT_MODEL=gpt-6-luna
CODEX_TOKEN_KEY=
CODEX_AUTH_JSON=
OPENAI_API_KEY=

# App
APP_URL=http://localhost:3000
CRON_SECRET=
